{% extends 'base.html.twig' %}

{% block title %}Détail de la tâche{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Détail de la tâche</h1>

        <div class="card mt-3">
            <div class="card-header">
                Tâche numéro {{ tache.id }}
            </div>

            <div class="card-body">
                <h2 class="card-title">
                    {{ tache.titre }}
                </h2>

                <p class="card-text">
                    <strong>Description :</strong>

                    {% if tache.description %}
                        {{ tache.description }}
                    {% else %}
                        Aucune description.
                    {% endif %}
                </p>

                <p>
                    <strong>Date de création :</strong>
                    {{ tache.dateCreation|date('d/m/Y H:i') }}
                </p>

                <p>
                    <strong>État :</strong>

                    {% if tache.terminee %}
                        <span class="badge bg-success">
                            Terminée
                        </span>
                    {% else %}
                        <span class="badge bg-warning text-dark">
                            En cours
                        </span>
                    {% endif %}
                </p>

                <a href="{{ path('app_taches') }}"
                   class="btn btn-secondary">
                    Retour à la liste
                </a>
            </div>
        </div>
    </div>
{% endblock %}