{% extends 'base.html.twig' %}

{% block title %}Liste des tâches{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Ma To-Do List</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <a href="{{ path('app_tache_ajouter') }}"
           class="btn btn-primary mb-4">
            + Ajouter une tâche
        </a>

        {% if taches is empty %}
            <div class="alert alert-info">
                Aucune tâche enregistrée.
            </div>
        {% else %}
            <div class="list-group">
                {% for tache in taches %}
                    <div class="list-group-item mb-2">
                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h5 class="{% if tache.terminee %}text-decoration-line-through text-muted{% endif %}">
                                    {{ tache.titre }}
                                </h5>

                                <p class="mb-1">
                                    {{ tache.description ?? 'Aucune description' }}
                                </p>

                                <small class="text-muted">
                                    Créée le
                                    {{ tache.dateCreation|date('d/m/Y à H:i') }}
                                </small>

                                <div class="mt-2">
                                    {% if tache.terminee %}
                                        <span class="badge bg-success">
                                            Terminée
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">
                                            À faire
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="{{ path('app_tache_detail', {'id': tache.id}) }}"
                                   class="btn btn-outline-primary btn-sm">
                                    Détails
                                </a>

                                {% if not tache.terminee %}
                                    <a href="{{ path('app_tache_terminer', {'id': tache.id}) }}"
                                       class="btn btn-success btn-sm">
                                        Terminer
                                    </a>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>

            <p class="mt-3 text-muted">
                {{ taches|length }} tâche(s) au total.
            </p>
        {% endif %}
    </div>
{% endblock %}
