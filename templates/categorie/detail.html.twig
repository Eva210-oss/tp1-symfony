{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }}{% endblock %}

{% block body %}

    <h1 class="mb-3">📂 {{ categorie.nom }}</h1>

    <p class="text-muted">
        {{ categorie.description ?? 'Aucune description disponible.' }}
    </p>

    <hr>

    <h4 class="mb-3">
        Articles associés
        <span class="badge bg-primary">
            {{ categorie.articles|length }}
        </span>
    </h4>

    {% if categorie.articles is empty %}

        <div class="alert alert-info">
            Aucun article dans cette catégorie.
        </div>

    {% else %}

        <div class="list-group mb-4">

            {% for article in categorie.articles %}

                <a href="{{ path('app_article_detail', {id: article.id}) }}"
                   class="list-group-item list-group-item-action">

                    <strong>{{ article.titre }}</strong>

                    <span class="text-muted">
                        — {{ article.auteur }}
                    </span>

                </a>

            {% endfor %}

        </div>

    {% endif %}

    <div class="d-flex gap-2">

        <a href="{{ path('app_article_nouveau', {categorie: categorie.id}) }}"
           class="btn btn-success">
            ➕ Ajouter un article
        </a>

        <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}"
           class="btn btn-primary">
            ✏️ Modifier
        </a>

        <a href="{{ path('app_categories') }}"
           class="btn btn-secondary">
            ← Retour
        </a>

    </div>

    <form method="post"
          action="{{ path('app_categorie_supprimer', {id: categorie.id}) }}"
          onsubmit="return confirm('Voulez-vous supprimer cette catégorie ?');"
          class="mt-3">

        <input type="hidden"
               name="_token"
               value="{{ csrf_token('supprimer_categorie_' ~ categorie.id) }}">

        <button class="btn btn-danger">
            🗑 Supprimer
        </button>

    </form>

{% endblock %}